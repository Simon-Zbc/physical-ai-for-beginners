# このファイルを .env にコピーして値を設定してください（.env は git 管理外です）
OPENAI_API_KEY=
# OpenAI: モデル名 / Azure OpenAI: デプロイ名（hierarchical_agent.py は JSON モード対応モデルが必要）
LLM_MODEL=
# Azure OpenAI を使う場合だけ、次の行のコメントを外して設定する。
# OpenAI の場合は書かない（空の値で書くと空文字として扱われ、接続に失敗する）。
# OPENAI_BASE_URL=https://<リソース名>.openai.azure.com/openai/v1/
